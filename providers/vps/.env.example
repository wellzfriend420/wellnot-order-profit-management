PUBLIC_BASE_URL=
HOURLY_RATE=0
BACKUP_INTERVAL_HOURS=24
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
WELLNOT_BIND_PORT=3300
